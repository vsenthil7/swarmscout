# ============================================================================
# SwarmScout — environment template.
# Copy to .env and fill in real values. .env is gitignored.
# ============================================================================

# --- Runtime mode ---
ENV=development                  # development | staging | production
LOG_LEVEL=INFO

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Postgres ---
POSTGRES_DSN=postgresql+asyncpg://swarmscout:swarmscout@localhost:5432/swarmscout
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=swarmscout
POSTGRES_PASSWORD=swarmscout
POSTGRES_DB=swarmscout

# --- DGrid AI Gateway (primary LLM router) ---
DGRID_BASE_URL=https://api.dgrid.ai/v1
DGRID_API_KEY=replace_with_dgrid_key

# --- Direct provider fallbacks ---
ANTHROPIC_API_KEY=replace_with_anthropic_key
OPENAI_API_KEY=replace_with_openai_key
GOOGLE_API_KEY=replace_with_google_key

# --- Per-agent model primary (fallback chains are configured in code per 07_LLD) ---
HUNTER_PRIMARY_MODEL=google/gemini-2.5-flash
SOCIAL_PRIMARY_MODEL=openai/gpt-4o
CHAIN_PRIMARY_MODEL=anthropic/claude-sonnet-4-6
RISK_PRIMARY_MODEL=anthropic/claude-opus-4-7
NARRATOR_PRIMARY_MODEL=anthropic/claude-opus-4-7

# --- Four.meme source (A-01 assumption resolved in Phase 5) ---
FOURMEME_SOURCE=polling          # polling | rpc_log
FOURMEME_POLL_URL=https://four.meme/api/tokens/new
FOURMEME_POLL_INTERVAL_SECONDS=10

# --- BNB Testnet ---
BNB_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BNB_CHAIN_ID=97
FINDINGS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_WALLET_PRIVATE_KEY=replace_with_testnet_only_key
BSCSCAN_API_KEY=replace_with_bscscan_key
BSCSCAN_BASE_URL=https://api-testnet.bscscan.com/api

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace_with_bot_token

# --- Social scraping ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_USER_DATA_DIR=/tmp/swarmscout-pw

# --- Cost controls ---
DAILY_COST_CAP_USD_ANTHROPIC=50
DAILY_COST_CAP_USD_OPENAI=50
DAILY_COST_CAP_USD_GOOGLE=20
DAILY_COST_CAP_USD_DGRID=100

# --- Rate limits ---
API_RATE_LIMIT_PER_MINUTE=60
BSCSCAN_RATE_LIMIT_PER_SEC=4

# --- Dashboard / API ---
PUBLIC_API_URL=http://localhost:8000
PUBLIC_DASHBOARD_URL=http://localhost:3000
WS_PATH=/ws/events

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=swarmscout
